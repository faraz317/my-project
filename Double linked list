class SmartDoublyList {

    Node first;
    Node last;

    // Node class
    static class Node {
        int info;
        Node prev;
        Node next;

        Node(int info) {
            this.info = info;
        }
    }

    // Insert at beginning
    public void addFirst(int val) {
        Node n = new Node(val);

        if (first == null) {
            first = last = n;
            return;
        }

        n.next = first;
        first.prev = n;
        first = n;
    }

    // Insert at end
    public void addLast(int val) {
        Node n = new Node(val);

        if (first == null) {
            first = last = n;
            return;
        }

        last.next = n;
        n.prev = last;
        last = n;
    }

    // Insert at position
    public void insertAt(int val, int pos) {
        if (pos == 1) {
            addFirst(val);
            return;
        }

        Node temp = first;
        int i = 1;

        while (i < pos - 1 && temp != null) {
            temp = temp.next;
            i++;
        }

        if (temp == null || temp.next == null) {
            addLast(val);
            return;
        }

        Node n = new Node(val);
        n.next = temp.next;
        n.prev = temp;

        temp.next.prev = n;
        temp.next = n;
    }

    // Delete first
    public void removeFirst() {
        if (first == null) {
            System.out.println("List empty!");
            return;
        }

        if (first == last) {
            first = last = null;
            return;
        }

        first = first.next;
        first.prev = null;
    }

    // Delete last
    public void removeLast() {
        if (first == null) {
            System.out.println("List empty!");
            return;
        }

        if (first == last) {
            first = last = null;
            return;
        }

        last = last.prev;
        last.next = null;
    }

    // Delete at position
    public void removeAt(int pos) {
        if (first == null) {
            System.out.println("List empty!");
            return;
        }

        if (pos == 1) {
            removeFirst();
            return;
        }

        Node temp = first;
        int i = 1;

        while (i < pos && temp != null) {
            temp = temp.next;
            i++;
        }

        if (temp == null) {
            System.out.println("Invalid position!");
            return;
        }

        if (temp == last) {
            removeLast();
            return;
        }

        temp.prev.next = temp.next;
        temp.next.prev = temp.prev;
    }

    // Delete by value
    public void removeByValue(int key) {
        Node temp = first;

        while (temp != null) {
            if (temp.info == key) {

                if (temp == first) {
                    removeFirst();
                } else if (temp == last) {
                    removeLast();
                } else {
                    temp.prev.next = temp.next;
                    temp.next.prev = temp.prev;
                }
                return;
            }
            temp = temp.next;
        }

        System.out.println("Value not found!");
    }

    // Search
    public void search(int key) {
        Node temp = first;
        int pos = 1;

        while (temp != null) {
            if (temp.info == key) {
                System.out.println("Found at position: " + pos);
                return;
            }
            temp = temp.next;
            pos++;
        }

        System.out.println("Not found!");
    }

    // Length
    public int count() {
        int c = 0;
        Node temp = first;

        while (temp != null) {
            c++;
            temp = temp.next;
        }

        return c;
    }

    // Forward traversal
    public void showForward() {
        Node temp = first;

        if (temp == null) {
            System.out.println("Empty!");
            return;
        }

        while (temp != null) {
            System.out.print(temp.info + " <-> ");
            temp = temp.next;
        }

        System.out.println("NULL");
    }

    // Backward traversal
    public void showBackward() {
        Node temp = last;

        if (temp == null) {
            System.out.println("Empty!");
            return;
        }

        while (temp != null) {
            System.out.print(temp.info + " <-> ");
            temp = temp.prev;
        }

        System.out.println("NULL");
    }

    // Clear list
    public void clear() {
        first = last = null;
    }

    public static void main(String[] args) {

        SmartDoublyList list = new SmartDoublyList();

        list.addLast(2);
        list.addLast(6);
        list.addLast(8);
        list.addFirst(1);

        System.out.println("Forward:");
        list.showForward();

        System.out.println("Backward:");
        list.showBackward();

        list.insertAt(5, 3);
        System.out.println("After Insert:");
        list.showForward();

        list.search(8);

        list.removeFirst();
        list.removeLast();
        list.removeAt(2);

        System.out.println("After Deletions:");
        list.showForward();

        list.removeByValue(5);
        list.showForward();

        System.out.println("Total Nodes: " + list.count());

        list.clear();
        list.showForward();

        // Info
        System.out.println("\nName: Muhammad Faraz");
        System.out.println("Seat: EB25210006054");
        System.out.println("Section: A");
    }
}
